{
  "name": "khabo-kothay",
  "version": "1.1.0",
  "description": "Khabo Kothay? (খাবো কোথায়?) - Dhaka traffic-aware dining recommendation engine and personal food assistant",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "cpp:build": "g++ -O3 -std=c++17 -Iengines/routing-core/include engines/routing-core/src/KDTree.cpp engines/routing-core/src/RoutingCore.cpp engines/routing-core/src/main.cpp -o engines/routing-core/routing_core.exe",
    "cpp:bench": "powershell -Command \"& ./engines/routing-core/routing_core.exe\"",
    "py:test": "python ml/analytics-pipeline/test_analytics.py",
    "py:pipeline": "python ml/analytics-pipeline/pipeline_runner.py",
    "java:build": "powershell -Command \"if (-not (Test-Path services/traffic-dispatch/bin)) { New-Item -ItemType Directory -Path services/traffic-dispatch/bin }; javac -d services/traffic-dispatch/bin (Get-ChildItem -Path services/traffic-dispatch/src -Filter *.java -Recurse).FullName\"",
    "java:test": "java -cp services/traffic-dispatch/bin com.khabokothay.TrafficDispatchTest",
    "java:run": "java -cp services/traffic-dispatch/bin com.khabokothay.TrafficApp",
    "test:all": "npm test && npm run py:test && npm run java:test"
  },
  "keywords": [
    "dhaka",
    "gulshan",
    "restaurants",
    "traffic-aware",
    "recommendations"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
