# ==============================================================================
# Khabo Kothay? Server Configuration Template (.env.example)
# Copy this file to .env and fill in required values for local development.
# ==============================================================================

# Server Network Port
PORT=3000

# Mock Mode (Set to true to run locally without Google Cloud API credentials)
USE_MOCK_DATA=true

# Google Cloud Maps Platform Keys
GOOGLE_SERVER_KEY=
GOOGLE_BROWSER_KEY=

# Usage Guard & Cost Control
MAX_GOOGLE_REQUESTS_PER_DAY=200

# Administrative Protection Token (Header: X-Admin-Token)
ADMIN_TOKEN=

# Database & Cache URLs (Optional)
DATABASE_URL=
REDIS_URL=

# AI & LLM Integration (Optional)
ANTHROPIC_API_KEY=

# Mobile Client Auth Token (Header: X-App-Token)
APP_CLIENT_TOKEN=
