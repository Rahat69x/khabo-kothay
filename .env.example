# Google Cloud Server Key (Used ONLY by Express server for Places & Routes API, NEVER sent to browser)
GOOGLE_SERVER_KEY=your_google_server_key_here

# Google Maps JavaScript Browser Key (Served via GET /api/config for browser Maps JS API & Android Maps SDK)
GOOGLE_BROWSER_KEY=your_google_browser_key_here

# Express Server Port
PORT=3000

# Run in mock mode with realistic Gulshan/Banani data without needing API keys
USE_MOCK_DATA=true

# Daily hard cap on external Google Places & Routes API requests (fails closed)
MAX_GOOGLE_REQUESTS_PER_DAY=200

# Admin token for /api/admin/usage and /api/admin/killswitch (send as X-Admin-Token header).
# Required in production; the example value below is rejected when NODE_ENV=production.
ADMIN_TOKEN=secret_admin_token

# Number of reverse-proxy hops in front of the server (Render: 1). Leave unset locally.
# TRUST_PROXY=1

# Where feedback / eval logs are written (defaults to server/data)
# DATA_DIR=/var/data/khabo

# Mobile App Client Token Deterrent (Header: X-App-Token)
APP_CLIENT_TOKEN=gulshan_app_secret_token_2026
