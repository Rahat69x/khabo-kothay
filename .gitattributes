# Auto-detect text files and normalize line endings
* text=auto

# Windows shell batch scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts must use LF
*.sh text eol=lf

# Explicit text files
*.java text
*.py text
*.js text
*.ts text
*.tsx text
*.json text
*.xml text
*.md text
*.css text
*.html text
*.yaml text
*.yml text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary
*.apk binary
*.aab binary
*.pdf binary
