# ==============================================================================
# Khabo Kothay? Repository Git Ignore Rules
# ==============================================================================

# Secrets and environment files
.env
.env.*
*.env
!.env.example
*.pem
*.p12
*.jks
*.keystore
keystore.properties
local.properties
google-services.json
!google-services.json.example

# Dependencies
node_modules/
.venv/
venv/

# Build outputs and compilation artifacts
dist/
build/
app/build/
android/app/build/
android/build/
.gradle/
android/.gradle/
bin/
target/
*.class
*.o
*.exe
*.pyc
__pycache__/

# Python cache & test coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
.coverage
*.coverage*

# Android / Native IDE artifacts
.idea/
*.iml
captures/
.cxx/
.externalNativeBuild/
.expo/
.expo-shared/

# Packaging binaries
*.apk
*.aab
/release/

# Temporary and log files
*.log
scripts/output/
scripts/cache/
Thumbs.db
.DS_Store

# Agent & IDE metadata
.agent/
.agents/
.gemini/
.gsd/

# Runtime operational and diagnostic logs
server/data/*.jsonl
server/data/*.json
!server/data/dhaka-locations.json
!server/data/ask-corpus.json
